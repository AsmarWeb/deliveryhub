<?php

namespace App\Http\Controllers\Api\V1;

use App\Http\Controllers\Controller;
use App\Models\Delivery;
use App\Models\DeliveryAssignment;
use App\Models\Driver;
use App\Models\Merchant;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;

class DeliveryTrackingController extends Controller
{
    public function __invoke(Request $request, Delivery $delivery): JsonResponse
    {
        $user = $request->user();

        if ($user->hasRole('admin')) {
            // Admins can view all deliveries.
        } elseif ($user->hasRole('merchant')) {
            $merchant = Merchant::query()->where('user_id', $user->id)->first();

            abort_unless(
                $merchant !== null && (int) $merchant->id === (int) $delivery->merchant_id,
                403
            );
        } elseif ($user->hasRole('driver')) {
            $driver = Driver::query()->where('user_id', $user->id)->first();

            abort_unless(
                $driver !== null && DeliveryAssignment::query()
                    ->where('delivery_id', $delivery->id)
                    ->where('driver_id', $driver->id)
                    ->where('status', 'accepted')
                    ->exists(),
                403
            );
        } else {
            abort(403);
        }

        $timeline = $delivery->statusHistories()
            ->orderBy('id')
            ->get(['id', 'from_status', 'to_status', 'reason', 'created_at'])
            ->map(fn($history) => [
                'from_status' => $history->from_status,
                'status' => $history->to_status,
                'reason' => $history->reason,
                'occurred_at' => $history->created_at?->toIso8601String(),
            ]);

        $assignment = DeliveryAssignment::query()
            ->where('delivery_id', $delivery->id)
            ->where('status', 'accepted')
            ->latest('id')
            ->first();

        $trackingDriver = $assignment
            ? Driver::query()->find($assignment->driver_id)
            : null;

        $driverLocation = null;

        $trackableStatuses = [
            'accepted',
            'pickup',
            'in_transit',
        ];

        if (in_array($delivery->status->value, $trackableStatuses, true)) {
            $assignment = DeliveryAssignment::query()
                ->where('delivery_id', $delivery->id)
                ->where('status', 'accepted')
                ->latest('id')
                ->first();

            $trackingDriver = $assignment
                ? Driver::query()->find($assignment->driver_id)
                : null;

            if (
                $trackingDriver &&
                $trackingDriver->current_latitude !== null &&
                $trackingDriver->current_longitude !== null &&
                $trackingDriver->last_location_at !== null &&
                $trackingDriver->last_location_at->between(
                    now()->subSeconds(60),
                    now()
                )
            ) {
                $driverLocation = [
                    'latitude' => (float) $trackingDriver->current_latitude,
                    'longitude' => (float) $trackingDriver->current_longitude,
                    'last_updated_at' =>
                    $trackingDriver->last_location_at->toIso8601String(),
                ];
            }
        }

        return response()->json([
            'data' => [
                'tracking_number' => $delivery->tracking_number,
                'status' => $delivery->status->value,
                'timeline' => $timeline,
                'driver_location' => $driverLocation,
            ],
        ]);
    }
}
