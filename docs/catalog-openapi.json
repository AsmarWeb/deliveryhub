{
  "openapi": "3.0.3",
  "info": {
    "title": "Raslo Enterprise Catalog API",
    "version": "1.0.0",
    "description": "Product synchronization and public discovery; see enterprise-catalog.md for entitlement, source ordering and limits."
  },
  "paths": {
    "/api/integrations/v1/products": {
      "get": {
        "summary": "List this connection’s products; catalog:read required",
        "security": [
          {
            "StoreKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/integrations/v1/products/batch": {
      "post": {
        "summary": "Upsert full product records; catalog:write required",
        "security": [
          {
            "StoreKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "products"
                ],
                "properties": {
                  "products": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/Product"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/products": {
      "get": {
        "summary": "Public approved catalog",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "store",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/merchant/integrations": {
      "get": {
        "summary": "List own store connections",
        "security": [
          {
            "MerchantToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      },
      "post": {
        "summary": "Create a connection; return its key once; feed mode starts initial synchronization",
        "security": [
          {
            "MerchantToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "mode",
                  "scopes"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "push",
                      "feed"
                    ]
                  },
                  "scopes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "catalog:read",
                        "catalog:write"
                      ]
                    }
                  },
                  "feed_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Feed mode only: approved HTTPS store endpoint without URL credentials, query or fragment."
                  },
                  "feed_token": {
                    "type": "string",
                    "writeOnly": true,
                    "minLength": 16,
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/merchant/integrations/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "patch": {
        "summary": "Update status or Feed URL/token on an own connection",
        "security": [
          {
            "MerchantToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "disabled"
                    ]
                  },
                  "feed_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "feed_token": {
                    "type": "string",
                    "writeOnly": true,
                    "minLength": 16,
                    "maxLength": 500
                  }
                },
                "minProperties": 1
              }
            }
          }
        }
      }
    },
    "/api/v1/merchant/integrations/{id}/rotate-key": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "summary": "Revoke old key and return replacement once",
        "security": [
          {
            "MerchantToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/merchant/integrations/{id}/sync": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "summary": "Queue a feed sync",
        "security": [
          {
            "MerchantToken": []
          }
        ],
        "responses": {
          "202": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/merchant/integrations/{id}/runs": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "summary": "List synchronization runs",
        "security": [
          {
            "MerchantToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/admin/catalog/{id}/approval": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "post": {
        "summary": "Approve/unapprove a store; administrator required",
        "security": [
          {
            "MerchantToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Enterprise entitlement or required scope missing"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "approved"
                ],
                "properties": {
                  "approved": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "StoreKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "raslo_live_..."
      },
      "MerchantToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_id",
          "name",
          "price_minor",
          "currency",
          "stock_quantity",
          "status",
          "source_updated_at"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "nullable": true
          },
          "sku": {
            "type": "string",
            "maxLength": 120,
            "nullable": true
          },
          "category": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "price_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999999999
          },
          "currency": {
            "type": "string",
            "enum": [
              "AED"
            ]
          },
          "stock_quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "draft",
              "archived"
            ]
          },
          "source_updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timezone-qualified whole-second source timestamp; strictly increasing for real changes and not in the future."
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "nullable": true
          },
          "product_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "nullable": true
          }
        }
      }
    }
  }
}
